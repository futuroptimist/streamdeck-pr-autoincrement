{
  "name": "streamdeck-pr-autoincrement",
  "version": "1.0.0",
  "description": "Stream Deck plugin that reads a GitHub PR URL from clipboard and outputs 4 incrementing PR URLs",
  "main": "com.futuroptimist.prlist.sdPlugin/bin/plugin.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "test:ci": "npm run build"
  },
  "keywords": [
    "streamdeck",
    "elgato",
    "github",
    "pull-request"
  ],
  "author": "futuroptimist",
  "license": "MIT",
  "dependencies": {
    "@elgato/streamdeck": "^1.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
